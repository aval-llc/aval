{
  "name": "site-creator-vinext-starter",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "vinext dev",
    "build": "vinext build",
    "start": "vinext start",
    "test": "npm run typecheck && npm run i18n:check && npm run build && npm run test:unit",
    "test:unit": "node --test --test-concurrency=1",
    "test:runtime": "npm run test:postgres",
    "typecheck": "tsc --noEmit",
    "i18n:check": "node scripts/check-i18n-parity.mjs",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next",
    "db:generate": "drizzle-kit generate",
    "db:inventory": "node scripts/migration/inventory.mjs",
    "db:postgres:schema": "node scripts/migration/generate-postgres-schema.mjs",
    "db:postgres:generate": "npm run db:postgres:schema && drizzle-kit generate --config drizzle.postgres.config.ts",
    "db:postgres:rls": "node scripts/migration/generate-rls.mjs",
    "db:postgres:publish": "node scripts/migration/publish-postgres-migrations.mjs && npm run db:postgres:rls",
    "db:sql-editor:build": "node scripts/migration/build-sql-editor-installer.mjs",
    "db:migrate": "node scripts/migration/apply-supabase-migrations.mjs",
    "db:runtime-role": "node scripts/migration/configure-runtime-role.mjs",
    "test:migration": "node --test tests/migration/*.test.mjs",
    "test:postgres": "node --import ./tests/integration/module-hooks.mjs --test --test-concurrency=1 tests/postgres/*.integration.mjs",
    "lint:migration": "eslint db/postgres infra/benchmark scripts/migration tests/migration tests/postgres",
    "db:spike:setup": "node --env-file=.env.migration.local scripts/migration/setup-spike.mjs",
    "db:spike:serve": "node --env-file=.env.migration.local scripts/migration/local-benchmark-server.mjs",
    "db:spike:configure": "node --env-file=.env.migration.local scripts/migration/configure-benchmark.mjs",
    "db:spike:bundle": "wrangler deploy --config infra/benchmark/wrangler.local.jsonc --dry-run --outdir ../../outputs/benchmark-worker",
    "db:benchmark": "node --env-file=.env.migration.local scripts/migration/run-benchmark.mjs",
    "db:benchmark:gate": "node scripts/migration/benchmark-gate.mjs",
    "supabase:start": "supabase start",
    "supabase:stop": "supabase stop",
    "supabase:reset": "supabase db reset",
    "cloudflare:deploy-config": "node scripts/configure-cloudflare-deploy.mjs",
    "start:local": "node scripts/local-server.mjs",
    "validate:providers": "node scripts/validate-live-providers.mjs",
    "check:subscription:codex": "node scripts/check-codex-subscription.mjs",
    "evaluate:semantic:codex": "node scripts/evaluate-codex-semantic.mjs docs/audit/codex-semantic-evaluation.json",
    "validate:runtime:codex": "node --import ./tests/integration/module-hooks.mjs scripts/validate-codex-runtime.mjs docs/audit/codex-runtime-validation.json",
    "validate:independence": "node --import ./tests/integration/module-hooks.mjs scripts/validate-independence.mjs",
    "compare:agents:codex": "node --import ./tests/integration/module-hooks.mjs scripts/compare-agent-llm.mjs",
    "test:db:start": "node scripts/database-harness.mjs start",
    "test:db:reset": "node scripts/database-harness.mjs reset",
    "test:db:stop": "node scripts/database-harness.mjs stop",
    "test:postgres:local": "AVAL_TEST_DATABASE_URL=$(node scripts/database-harness.mjs reset) npm run test:postgres"
  },
  "dependencies": {
    "@radix-ui/react-dialog": "^1.1.23",
    "@radix-ui/react-icons": "^1.3.2",
    "@radix-ui/react-select": "^2.3.7",
    "@radix-ui/react-separator": "^1.1.15",
    "@radix-ui/react-slot": "^1.3.3",
    "@radix-ui/react-tabs": "^1.1.21",
    "border-beam": "^1.3.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.4.0",
    "dinero.js": "^2.0.2",
    "docx": "^9.7.1",
    "docxtemplater": "^3.69.3",
    "drizzle-orm": "0.45.2",
    "exceljs": "^4.4.0",
    "iconoir-react": "^7.12.1",
    "jspdf": "^4.2.1",
    "liquid-gooey": "^0.2.1",
    "lucide-react": "^1.40.0",
    "next-intl": "^4.13.7",
    "pg": "^8.23.0",
    "pizzip": "^3.2.0",
    "pptxgenjs": "^4.0.1",
    "react": "19.2.8",
    "react-day-picker": "^10.0.1",
    "react-dom": "19.2.8",
    "simple-icons": "^16.28.0",
    "tailwind-merge": "^3.6.0",
    "thinking-orbs": "^0.3.1",
    "voice-glow": "^0.2.0"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.37.1",
    "@cloudflare/workers-types": "^4.20260702.1",
    "@eslint/js": "9.39.4",
    "@next/eslint-plugin-next": "16.2.6",
    "@openai/sites-vite-plugin": "0.1.0",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "22.19.19",
    "@types/pg": "^8.23.1",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.26",
    "drizzle-kit": "0.31.10",
    "esbuild": "^0.28.2",
    "eslint": "9.39.4",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-react": "7.37.5",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "16.4.0",
    "react-server-dom-webpack": "19.2.8",
    "supabase": "^2.117.0",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3",
    "typescript-eslint": "8.59.3",
    "vinext": "1.0.0-beta.2",
    "vite": "8.0.16",
    "wrangler": "4.92.0"
  },
  "type": "module",
  "overrides": {
    "vinext": {
      "image-size": "2.0.3"
    }
  }
}
