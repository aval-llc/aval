# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/.vinext/
/out/

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (the empty key manifest is safe and intentional)
.env*
!.env.example
.dev.vars*
*.tsbuildinfo

# vercel
.vercel

/dist/
/.wrangler/
/outputs/
/work/
/.superdesign/tmp/

# Claude Code local worktrees (registered git worktrees, never part of a commit)
/.claude/worktrees/
