# Generate a long random value and store it only in the deployment secret manager.
INTEGRATION_TOKEN_ENCRYPTION_KEY=

# Server-only Supabase Auth values. The browser never receives the database URL.
SUPABASE_URL=
SUPABASE_ANON_KEY=
# Local development only; Cloudflare production uses the HYPERDRIVE binding.
DATABASE_URL=
# Password for the restricted `aval_runtime` login created during setup.
AVAL_DATABASE_PASSWORD=
# Cloudflare resource id used to materialize wrangler.deploy.generated.jsonc.
AVAL_HYPERDRIVE_ID=

# Optional server-only key for the live, newest-first Unsplash Wallpapers picker.
# Without it, Aval keeps a small attributed Unsplash fallback set.
UNSPLASH_ACCESS_KEY=

# OAuth applications
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
SLACK_SIGNING_SECRET=
NOTION_CLIENT_ID=
NOTION_CLIENT_SECRET=
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
XERO_CLIENT_ID=
XERO_CLIENT_SECRET=
QUICKBOOKS_CLIENT_ID=
QUICKBOOKS_CLIENT_SECRET=
QUICKBOOKS_ENVIRONMENT=production
BOX_CLIENT_ID=
BOX_CLIENT_SECRET=

# Webhook verification and Meta WhatsApp Cloud API
META_WHATSAPP_APP_SECRET=
META_WHATSAPP_VERIFY_TOKEN=
META_GRAPH_API_VERSION=v23.0

# Optional server-managed providers (tenant-scoped credentials are encrypted in PostgreSQL)
TELEGRAM_WEBHOOK_SECRET=
APPLE_MSP_WEBHOOK_SECRET=
TWILIO_AUTH_TOKEN=

# Public HTTPS origin used for signed voice/message status callbacks
AVAL_PUBLIC_URL=

# The PMS seat reader's shared secret for POST /api/pms/seat/adjudicate.
# The reader Worker holds the unverified inbox and no database; the app holds
# the database and no inbox, so one authenticated call per message joins them.
# Set on the app AND on the reader (npx wrangler secret put PMS_SEAT_READER_TOKEN
# --config wrangler.reader.jsonc). Unset, the route fails closed with 503.
PMS_SEAT_READER_TOKEN=
